# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string (Neon/Supabase/local). Prisma Migrate reads this
# via prisma7.config.ts; the app reads it via lib/db/prisma.ts.
DATABASE_URL="postgresql://user:password@host:5432/remedial_one?sslmode=require"

# Bootstraps a SUPER_ADMIN account when running `npm run db:seed`.
# Public signup can never create ADMIN/SUPER_ADMIN accounts — this is the
# only way to create the first one. Change the password after first login.
SEED_SUPER_ADMIN_EMAIL="superadmin@remedial.one"
SEED_SUPER_ADMIN_PASSWORD=""

# LiveKit Cloud (or self-hosted) project — free tier at https://cloud.livekit.io.
# API key/secret are server-only (used to mint join tokens, never sent to the
# browser). The wss:// URL is safe to expose client-side (NEXT_PUBLIC_ prefix).
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"

# Whiteboard real-time layer — a standalone WS server (see /Server) separate
# from this Next.js app. WHITEBOARD_WS_TICKET_SECRET is a single-purpose
# HMAC secret shared with that process (must match its own .env) used to
# sign short-lived join tickets; never reuse the LiveKit secret here. The
# ws(s):// URL is safe to expose client-side (NEXT_PUBLIC_ prefix).
WHITEBOARD_WS_TICKET_SECRET=""
NEXT_PUBLIC_WHITEBOARD_WS_URL="ws://localhost:4001"

# Vercel Blob — stores whiteboard image/PDF-page uploads. Create a Blob
# store in the Vercel dashboard (Storage tab) or via `vercel blob store add`
# to get this token. Server-only; the browser uploads directly to Blob
# storage using a short-lived token minted by /api/whiteboard-uploads, never
# this value itself.
BLOB_READ_WRITE_TOKEN=""

# NVIDIA NIM (https://build.nvidia.com) — powers the AI-written insight on
# the student progress/stats page, and the AI class-notes feature (see
# lib/ai/nvidia.ts). Server-only; never exposed to the browser. Both are
# skipped gracefully when unset. NVIDIA_VISION_MODEL must be a
# vision-capable model (class notes are generated from a whiteboard
# snapshot image) — NVIDIA_MODEL is text-only and can't be reused for this.
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.1-8b-instruct"
NVIDIA_VISION_MODEL="meta/llama-3.2-11b-vision-instruct"

# Resend (https://resend.com) — powers transactional email: signup
# verification, password reset, and "note shared" notifications (see
# lib/email/). Server-only. Emails are skipped (logged instead) when unset,
# same graceful-skip pattern as NVIDIA_API_KEY above.
RESEND_API_KEY=""
EMAIL_FROM="Remedial One <onboarding@resend.dev>"

# Used server-side to build absolute links inside emails (verify/reset
# links). Set this to your deployed origin in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Internal CRM (separate app + database — see Crm/my-app). Public
# lead-generation forms (book-counselling, contact, teacher application, ...)
# forward their submissions here as signed webhooks — see
# lib/integrations/crmWebhook.ts. Skipped gracefully when unset, same
# best-effort pattern as RESEND_API_KEY above. WEBSITE_WEBHOOK_SECRET must be
# the exact same value as Crm/my-app's .env WEBSITE_WEBHOOK_SECRET.
CRM_WEBHOOK_URL="http://localhost:3001/api/webhooks/website"
WEBSITE_WEBHOOK_SECRET=""

# Bearer token the CRM presents when calling this app's internal
# /api/integrations/crm/* endpoints (student/mentor account provisioning —
# see lib/auth/service-token.ts). Must match REMIDIAL_ONE_SERVICE_TOKEN in
# Crm/my-app's .env exactly.
CRM_SERVICE_TOKEN=""