# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string (Neon/Supabase/local). Prisma Migrate reads this
# via prisma7.config.ts; the app reads it via lib/db/prisma.ts.
DATABASE_URL="postgresql://user:password@host:5432/remedial_one?sslmode=require"

# Bootstraps a SUPER_ADMIN account when running `npm run db:seed`.
# Public signup can never create ADMIN/SUPER_ADMIN accounts — this is the
# only way to create the first one. Change the password after first login.
SEED_SUPER_ADMIN_EMAIL="superadmin@remedial.one"
SEED_SUPER_ADMIN_PASSWORD=""

# LiveKit Cloud (or self-hosted) project — free tier at https://cloud.livekit.io.
# API key/secret are server-only (used to mint join tokens, never sent to the
# browser). The wss:// URL is safe to expose client-side (NEXT_PUBLIC_ prefix).
LIVEKIT_API_KEY="API8we2XsQ2fuJC"
LIVEKIT_API_SECRET="ec0KghpzGnEgFRaPIEP4ARKJUeKuMlzCQDDdZ9tMfbLA"
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
