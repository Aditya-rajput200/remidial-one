// Remedial One — core schema.
// Phase 2: Auth + RBAC + user profiles.
// Phase 4: Subjects, grades, mentor discovery, availability, booking.
// Phase 5 (partial): Live-session whiteboard (Whiteboard / WhiteboardPage /
// WhiteboardObject / WhiteboardOperation / WhiteboardSnapshot /
// WhiteboardParticipant below) — the first of the deferred video/CMS/payments
// models to land, because it's part of the same live classroom room as
// video. Note (below) is the first real slice of the deferred "resource
// library" — a mentor-uploaded file scoped to one Booking. Recording, chat,
// assignments, and payments models are still deferred — do not add them
// here speculatively.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  MENTOR
  PARENT
  ADMIN
  SUPER_ADMIN
  CONTENT_MANAGER
  SUPPORT_AGENT
  FINANCE_MANAGER
  MODERATOR
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MentorApplicationStatus {
  APPLICATION
  UNDER_REVIEW
  VERIFIED
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ParentLinkStatus {
  PENDING
  APPROVED
  REVOKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum WhiteboardObjectType {
  PATH
  LINE
  ARROW
  RECTANGLE
  ELLIPSE
  TRIANGLE
  TEXT
  STICKY_NOTE
  EQUATION
  IMAGE
}

enum WhiteboardOperationType {
  OBJECT_CREATE
  OBJECT_UPDATE
  OBJECT_DELETE
  PAGE_CREATE
  PAGE_UPDATE
  PAGE_DELETE
  PAGE_REORDER
  BOARD_LOCK
  BOARD_UNLOCK
}

enum WhiteboardPermissionLevel {
  VIEW_ONLY
  COLLABORATE
  FULL_COLLABORATION
}

enum WhiteboardBackground {
  BLANK
  GRID
  RULED
  DOTTED
  GRAPH_PAPER
}

// ---------------------------------------------------------------------------
// Core identity
// ---------------------------------------------------------------------------

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String
  role            Role
  status          AccountStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  name            String
  avatarUrl       String?
  timezone        String        @default("UTC")
  locale          String        @default("en")
  country         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  studentProfile StudentProfile?
  mentorProfile  MentorProfile?
  parentProfile  ParentProfile?
  adminProfile   AdminProfile?

  sessions        Session[]
  emailTokens     EmailVerificationToken[]
  resetTokens     PasswordResetToken[]
  userPermissions UserPermission[]

  auditLogsAsActor AuditLog[] @relation("AuditLogActor")

  whiteboardPagesCreated   WhiteboardPage[]        @relation("WhiteboardPageCreator")
  whiteboardObjectsCreated WhiteboardObject[]      @relation("WhiteboardObjectCreator")
  whiteboardOperations     WhiteboardOperation[]   @relation("WhiteboardOperationActor")
  whiteboardParticipations WhiteboardParticipant[]
  sessionAttendance        SessionAttendance[]
  notesUploaded            Note[]                  @relation("NoteUploader")
  classNotesGenerated      ClassNote[]             @relation("ClassNoteGenerator")

  chaptersCreated      Chapter[]
  topicsCreated        Topic[]
  questionsCreated     Question[]
  assessmentsCreated   Assessment[]
  evaluationsGiven     Evaluation[]
  feedbackAuthored     Feedback[]
  recommendationsMade  Recommendation[]
  assessmentEventsMade AssessmentEvent[]
  blogPostsAuthored    BlogPost[]

  counsellingRequestActivities CounsellingRequestActivity[]
  contactMessageActivities     ContactMessageActivity[]

  @@index([role])
  @@index([status])
}

// Server-side session record. The raw session token is only ever held by the
// client (httpOnly cookie) — we store a SHA-256 hash so a DB leak can't be
// replayed as a live session.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Role-based access control
// ---------------------------------------------------------------------------

// Canonical list of fine-grained permission keys (e.g. "students.read").
// Seeded by prisma/seed.ts — see lib/auth/permissions.ts for the source list.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

// Default permission grants per role.
model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

// Per-user overrides on top of the role defaults (grant or explicitly revoke).
// Used sparingly — e.g. a SUPPORT_AGENT temporarily granted payments.refund.
model UserPermission {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect       PermissionEffect @default(GRANT)
  grantedById  String?
  reason       String?
  createdAt    DateTime         @default(now())

  @@unique([userId, permissionId])
  @@index([userId])
}

enum PermissionEffect {
  GRANT
  REVOKE
}

// ---------------------------------------------------------------------------
// Role profiles
// ---------------------------------------------------------------------------

model StudentProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade              String?
  curriculum         String?
  subjectsOfInterest String[] @default([])
  learningGoals      String?
  preferredTime      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  parentLinks ParentChildLink[]
  bookings    Booking[]

  assessmentAssignments AssessmentAssignment[]
  studentAssessments    StudentAssessment[]
  learningProfile       StudentLearningProfile?
  recommendations       Recommendation[]
}

model MentorProfile {
  id              String                  @id @default(cuid())
  userId          String                  @unique
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          MentorApplicationStatus @default(APPLICATION)
  bio             String?
  qualifications  String?
  teachingStyle   String?
  languages       String[]                @default([])
  hourlyRate      Decimal?                @db.Decimal(10, 2)
  currency        String                  @default("USD")
  yearsExperience Int?
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  subjects     Subject[]
  grades       Grade[]
  availability MentorAvailability[]
  bookings     Booking[]

  @@index([status])
}

model ParentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children ParentChildLink[]
}

model AdminProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String?
  twoFactorSecret    String?
  twoFactorEnabledAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ParentChildLink {
  id        String           @id @default(cuid())
  parentId  String
  parent    ParentProfile    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    ParentLinkStatus @default(PENDING)
  createdAt DateTime         @default(now())

  @@unique([parentId, studentId])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Subjects, grades, mentor discovery, availability, booking
// ---------------------------------------------------------------------------

// Seeded from the existing marketing copy in lib/content/subjects.ts (see
// prisma/seed.ts). The marketing site still reads that static file directly
// for now — this table exists so mentors/bookings can reference a real
// subjectId. Admin-editable CMS management of this content is Phase 9.
model Subject {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortDescription String
  icon             String
  isPublished      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  grades   Grade[]
  mentors  MentorProfile[]
  bookings Booking[]

  chapters    Chapter[]
  assessments Assessment[]
  questions   Question[]

  @@index([isPublished])
}

// Seeded from lib/content/classes.ts — see the Subject comment above.
model Grade {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  range     String
  tagline   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects Subject[]
  mentors  MentorProfile[]
}

// Recurring weekly availability. dayOfWeek follows JS Date#getDay (0 = Sunday
// .. 6 = Saturday) so it lines up with any Date-based scheduling logic.
model MentorAvailability {
  id        String        @id @default(cuid())
  mentorId  String
  mentor    MentorProfile @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startHour Int
  endHour   Int

  @@index([mentorId])
}

model Booking {
  id               String         @id @default(cuid())
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentorId         String
  mentor           MentorProfile  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  subjectId        String
  subject          Subject        @relation(fields: [subjectId], references: [id])
  gradeLabel       String?
  scheduledAt      DateTime
  durationMinutes  Int            @default(60)
  status           BookingStatus  @default(CONFIRMED)
  studentNotes     String?
  cancelledById    String?
  cancelReason     String?
  // Mentor-given score for a completed session — the input to the student
  // stats/score dashboard (see app/student/progress). Only settable by the
  // assigned mentor once status is COMPLETED (see app/api/bookings/[id]).
  mentorRating     Int?
  mentorRatingNote String?
  ratedAt          DateTime?
  // Actual (not scheduled) timing, derived from SessionAttendance rows —
  // actualStartedAt is set on the first join, actualEndedAt is bumped
  // forward on every leave (see app/api/bookings/[id]/attendance).
  actualStartedAt  DateTime?
  actualEndedAt    DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  whiteboard Whiteboard?
  attendance SessionAttendance[]
  notes      Note[]
  classNote  ClassNote?

  // Double-booking guard: a partial unique index on (mentorId, scheduledAt)
  // WHERE status IN ('PENDING','CONFIRMED') is created directly in
  // migration.sql (Prisma's schema DSL can't express partial indexes) — a
  // cancelled booking must free up its slot, so a plain @@unique here would
  // be wrong. See prisma/migrations/20260827110000_booking_active_slot_unique.
  // Overlap from mismatched durations is additionally checked in the service
  // layer (see app/api/bookings/route.ts).
  @@index([studentId])
  @@index([mentorId])
  @@index([scheduledAt])
}

// One row per join; a reconnect opens a new row rather than reusing the old
// one, so a participant's full in/out history for a session is preserved.
// leftAt is null while the participant is still connected.
model SessionAttendance {
  id        String    @id @default(cuid())
  bookingId String
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  @@index([bookingId])
  @@index([userId])
}

// A file (PDF/image/doc/etc.) a mentor uploads and shares with the student on
// a specific Booking — stored in Vercel Blob (see app/api/notes), fileUrl
// points there. Scoped 1:1 to a Booking (like Whiteboard above) rather than
// broadcast to a mentor's whole roster, so only that booking's student (and
// the uploading mentor) can see/download it.
model Note {
  id           String   @id @default(cuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User     @relation("NoteUploader", fields: [uploadedById], references: [id])
  title        String
  fileUrl      String
  fileName     String
  fileSize     Int
  mimeType     String
  createdAt    DateTime @default(now())

  @@index([bookingId])
  @@index([uploadedById])
}

// AI-generated summary of a class, produced from a whiteboard snapshot at
// the mentor's request (see app/api/bookings/[id]/class-notes) — distinct
// from Note above, which is a mentor-uploaded file. One per Booking;
// regenerating replaces the existing content (upsert), not versioned.
model ClassNote {
  id               String   @id @default(cuid())
  bookingId        String   @unique
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  generatedById    String
  generatedBy      User     @relation("ClassNoteGenerator", fields: [generatedById], references: [id])
  content          String
  snapshotImageUrl String?
  model            String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([bookingId])
  @@index([generatedById])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

// A marketing blog post, authored via the admin CMS editor. Gated by the
// existing cms.read/cms.update/cms.publish permissions (see
// lib/auth/permissions.ts) rather than a new permission set — publishing
// (DRAFT -> PUBLISHED) specifically requires cms.publish, which ADMIN does
// not hold by default (see permissions.ts DEFAULT_ROLE_PERMISSIONS comment).
model BlogPost {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  excerpt        String
  content        String // sanitized HTML from the admin rich text editor — see lib/blog/sanitize.ts
  coverImageUrl  String?
  category       String?
  tags           String[]   @default([])
  status         BlogStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  authorId       String
  author         User       @relation(fields: [authorId], references: [id])
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Live-session whiteboard — one per Booking, lazily created on first access
// (see lib/whiteboard/access.ts). Board content is stored as editable
// objects (WhiteboardObject), never a flattened image, and every mutation
// is timestamped via WhiteboardOperation so a future feature can
// synchronize recorded video playback with a reconstructed board state at
// that moment. Real-time sync/persistence is handled by the standalone WS
// server in /Server, which writes to these same tables directly.
// ---------------------------------------------------------------------------

model Whiteboard {
  id                String                    @id @default(cuid())
  bookingId         String                    @unique
  booking           Booking                   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  defaultPermission WhiteboardPermissionLevel @default(COLLABORATE)
  isLocked          Boolean                   @default(false)
  lockedById        String?
  lockedAt          DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  pages        WhiteboardPage[]
  participants WhiteboardParticipant[]
  operations   WhiteboardOperation[]
  snapshots    WhiteboardSnapshot[]

  @@index([bookingId])
}

model WhiteboardPage {
  id           String               @id @default(cuid())
  whiteboardId String
  whiteboard   Whiteboard           @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)
  name         String               @default("Page 1")
  // Ordering key. Not @@unique — reordering rewrites all positions for a
  // whiteboard inside one transaction (see lib/whiteboard/pages.ts), which
  // would violate a unique constraint mid-transaction on some isolation
  // levels. A plain index is sufficient since the app is the only writer.
  position     Int
  background   WhiteboardBackground @default(BLANK)
  createdById  String
  createdBy    User                 @relation("WhiteboardPageCreator", fields: [createdById], references: [id])
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  objects    WhiteboardObject[]
  operations WhiteboardOperation[]
  snapshots  WhiteboardSnapshot[]

  @@index([whiteboardId, position])
}

// Current-state table: one row per live object, upserted as operations are
// applied. This — not WhiteboardOperation — is what a late-joining client
// hydrates from and what renders on screen. Geometry/type-specific style
// live in `data` (JSON) because they vary per WhiteboardObjectType; the
// columns that are actually queried/filtered/sorted across all types
// (pageId, type, createdById, zIndex) are real columns so they stay
// indexed SQL rather than JSON scans.
model WhiteboardObject {
  id          String               @id // client-generated at creation time — see lib client id strategy
  pageId      String
  page        WhiteboardPage       @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type        WhiteboardObjectType
  createdById String
  createdBy   User                 @relation("WhiteboardObjectCreator", fields: [createdById], references: [id])
  zIndex      Int                  @default(0)
  x           Float
  y           Float
  width       Float?
  height      Float?
  rotation    Float                @default(0)
  data        Json
  isDeleted   Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([pageId, isDeleted])
  @@index([pageId, zIndex])
  @@index([createdById])
}

// Append-only event log. Enables reconnect diffing (future), undo/redo
// provenance, and — deliberately — timestamps every op so a
// recording-timeline/replay feature can be built later without a schema
// change, even though that UI is out of scope for now.
model WhiteboardOperation {
  id           String                  @id @default(cuid())
  whiteboardId String
  whiteboard   Whiteboard              @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)
  pageId       String?
  page         WhiteboardPage?         @relation(fields: [pageId], references: [id], onDelete: SetNull)
  objectId     String?
  type         WhiteboardOperationType
  actorId      String
  actor        User                    @relation("WhiteboardOperationActor", fields: [actorId], references: [id])
  payload      Json
  clientOpId   String
  createdAt    DateTime                @default(now())

  @@unique([whiteboardId, clientOpId])
  @@index([whiteboardId, createdAt])
  @@index([pageId])
}

// Periodic checkpoint used to safely prune WhiteboardOperation once its
// contents are folded in — not needed for ordinary reconnect (that reads
// WhiteboardObject directly). Included now so operation-log compaction and
// future replay have where to anchor without a later schema change.
model WhiteboardSnapshot {
  id              String         @id @default(cuid())
  whiteboardId    String
  whiteboard      Whiteboard     @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)
  pageId          String
  page            WhiteboardPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  upToOperationId String
  upToCreatedAt   DateTime
  objects         Json
  createdAt       DateTime       @default(now())

  @@index([whiteboardId, pageId, upToCreatedAt])
}

// Per-participant permission override + presence bookkeeping. Null
// `permission` inherits Whiteboard.defaultPermission — this is what makes
// selective per-student collaboration possible without a permission row
// for every student on every board.
model WhiteboardParticipant {
  id           String                     @id @default(cuid())
  whiteboardId String
  whiteboard   Whiteboard                 @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)
  userId       String
  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   WhiteboardPermissionLevel?
  color        String?
  lastSeenAt   DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@unique([whiteboardId, userId])
  @@index([whiteboardId])
}

// ---------------------------------------------------------------------------
// Audit trail — every sensitive admin/system action writes one of these.
// Never write passwords, tokens, secrets, or full payment details into
// `metadata`.
// ---------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Assessment / test engine.
//
// A Question lives in a reusable bank (createdById-owned) and is attached to
// zero or more AssessmentModules via AssessmentModuleQuestion, which carries
// the per-use marks/order — the same question can be reused across tests at
// different marks. Chapter/Topic are real per-Subject catalog entities (not
// free text) purely so chapter/topic analytics can group cleanly; mentors
// create them inline while building a test.
//
// Once an Assessment first leaves DRAFT for LIVE, `publishedSnapshot` freezes
// its module/question structure — later edits bump `version` rather than
// mutating what students already in progress are answering (mirrors the
// Booking/Whiteboard "existing state must not be corrupted by later edits"
// principle elsewhere in this schema).
//
// Analytics (ChapterMetric/TopicMetric/SkillMetric/CognitiveMetric/
// QuestionTypeMetric/AssessmentMetric/QuestionMetric/StudentLearningProfile)
// are precomputed and persisted at evaluation-finalize/publish time, not
// recomputed per page view — there is no queue/worker in this stack, so
// "precomputed" here means "computed synchronously by the route that just
// changed the underlying data," not "computed in a background job."
// ---------------------------------------------------------------------------

enum QuestionType {
  MCQ
  MULTIPLE_CORRECT
  TRUE_FALSE
  FILL_BLANK
  MATCH_FOLLOWING
  SHORT_ANSWER
  LONG_ANSWER
  IMAGE_ANSWER
  NUMERICAL
  EQUATION
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum CognitiveLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum QuestionSkill {
  MEMORY
  RECALL
  CONCEPTUAL_UNDERSTANDING
  READING
  WRITING
  MENTAL_ABILITY
  LOGICAL_REASONING
  CRITICAL_THINKING
  PROBLEM_SOLVING
  ANALYTICAL_THINKING
  APPLICATION
  CALCULATION
  INTERPRETATION
  CREATIVITY
  COMMUNICATION
}

enum QuestionPurpose {
  DIAGNOSTIC
  PRACTICE
  REVISION
  ASSESSMENT
  COMPETITIVE
  REMEDIAL
  MASTERY
}

enum QuestionStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum QuestionSource {
  MANUAL
  AI_GENERATED
  IMPORTED
}

enum AssessmentStatus {
  DRAFT
  REVIEW
  SCHEDULED
  LIVE
  PAUSED
  ENDED
  EVALUATION
  RESULT_READY
  ARCHIVED
}

enum ResultVisibility {
  SCORE_ONLY
  SCORE_AND_ANSWERS
  FULL_DETAIL
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
}

enum QuestionAttemptState {
  NOT_VISITED
  VISITED
  ANSWERED
  MARKED_FOR_REVIEW
  ANSWERED_MARKED
}

enum SubmissionReason {
  MANUAL
  AUTO_SUBMITTED
  TIME_EXPIRED
  TEACHER_ENDED
}

enum EvaluationStatus {
  PENDING
  AI_SUGGESTED
  TEACHER_REVIEWED
  FINALIZED
}

enum ResultStatus {
  EVALUATION_PENDING
  UNDER_REVIEW
  READY_TO_PUBLISH
  PUBLISHED
}

enum FeedbackScope {
  OVERALL
  MODULE
  QUESTION
  CHAPTER
}

enum RecommendationSource {
  AI
  TEACHER
}

enum AssessmentEventType {
  TEST_STARTED
  QUESTION_VIEWED
  ANSWER_SAVED
  ANSWER_CHANGED
  MARKED_FOR_REVIEW
  MODULE_STARTED
  MODULE_COMPLETED
  TEST_SUBMITTED
  TEST_AUTO_SUBMITTED
  TEST_PAUSED
  TEST_RESUMED
}

// ---------------------------------------------------------------------------
// Catalog: chapters/topics per subject.
// ---------------------------------------------------------------------------

model Chapter {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name        String
  order       Int      @default(0)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics    Topic[]
  questions Question[]

  chapterMetrics ChapterMetric[]

  @@unique([subjectId, name])
  @@index([subjectId])
}

model Topic {
  id          String   @id @default(cuid())
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  name        String
  order       Int      @default(0)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions Question[]

  topicMetrics TopicMetric[]

  @@unique([chapterId, name])
  @@index([chapterId])
}

// ---------------------------------------------------------------------------
// Question bank. `content` holds type-specific payload (options/correct
// ids/tolerance/pairs/accepted answers) — validated by a discriminated Zod
// union per QuestionType in lib/validation/question.ts on every write,
// manual or AI-generated alike. Same "typed columns for what's filtered,
// JSON for what varies by type" split already used by WhiteboardObject.data.
// ---------------------------------------------------------------------------

model Question {
  id          String   @id @default(cuid())
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  chapterId   String?
  chapter     Chapter? @relation(fields: [chapterId], references: [id])
  topicId     String?
  topic       Topic?   @relation(fields: [topicId], references: [id])
  subtopic    String?

  type           QuestionType
  difficulty     QuestionDifficulty @default(MEDIUM)
  cognitiveLevel CognitiveLevel     @default(UNDERSTAND)
  skills         QuestionSkill[]    @default([])
  purpose        QuestionPurpose    @default(ASSESSMENT)
  status         QuestionStatus     @default(DRAFT)
  source         QuestionSource     @default(MANUAL)

  text        String
  explanation String?
  hint        String?
  tags        String[] @default([])

  defaultMarks         Decimal @default(1) @db.Decimal(6, 2)
  defaultNegativeMarks Decimal @default(0) @db.Decimal(6, 2)
  estimatedTimeSeconds Int     @default(60)

  // Type-specific payload, e.g. { options: [{id,text}], correctOptionIds: [] }
  // for MCQ, { acceptedAnswers: [], caseSensitive: false } for FILL_BLANK,
  // { tolerance, unit } for NUMERICAL, { pairs: [{left,right}] } for
  // MATCH_FOLLOWING. See lib/validation/question.ts for the full contract.
  content Json
  media   Json?

  // Generation params/model when source = AI_GENERATED, kept for audit and
  // "regenerate" — never trusted as-is, always re-validated against `content`.
  aiMeta Json?

  isArchived Boolean @default(false)
  usageCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moduleQuestions  AssessmentModuleQuestion[]
  questionAttempts StudentQuestionAttempt[]
  metric           QuestionMetric?

  @@index([createdById])
  @@index([subjectId])
  @@index([chapterId])
  @@index([topicId])
  @@index([type])
  @@index([difficulty])
  @@index([cognitiveLevel])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Assessment (test) + modules + assignment to specific students.
// ---------------------------------------------------------------------------

model Assessment {
  id          String   @id @default(cuid())
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  title       String
  description String?
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  gradeLabel  String?

  difficulty   QuestionDifficulty?
  instructions String?

  durationMinutes Int
  totalMarks      Decimal  @default(0) @db.Decimal(7, 2)
  passingMarks    Decimal? @db.Decimal(7, 2)
  attemptLimit    Int      @default(1)

  negativeMarkingEnabled Boolean @default(false)
  calculatorAllowed      Boolean @default(false)
  freeNavigation         Boolean @default(true)
  autoSubmitOnExpiry     Boolean @default(true)
  randomizeQuestions     Boolean @default(false)
  randomizeOptions       Boolean @default(false)

  resultVisibility   ResultVisibility @default(SCORE_ONLY)
  showCorrectAnswers Boolean          @default(false)
  showSolutions      Boolean          @default(false)
  showRank           Boolean          @default(false)
  showClassAverage   Boolean          @default(false)

  startAt DateTime?
  endAt   DateTime?

  status AssessmentStatus @default(DRAFT)

  // Frozen module/question/marks structure as of the first DRAFT -> LIVE
  // transition (see the section comment above) — student attempts always
  // read/score against this, never live-editable state.
  version           Int   @default(1)
  publishedSnapshot Json?

  resultsPublishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules            AssessmentModule[]
  assignments        AssessmentAssignment[]
  studentAssessments StudentAssessment[]
  events             AssessmentEvent[]
  metric             AssessmentMetric?

  @@index([createdById])
  @@index([status])
  @@index([subjectId])
}

model AssessmentAssignment {
  id           String         @id @default(cuid())
  assessmentId String
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedAt   DateTime       @default(now())

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

model AssessmentModule {
  id               String     @id @default(cuid())
  assessmentId     String
  assessment       Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  instructions     String?
  order            Int        @default(0)
  timeLimitMinutes Int?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  questions      AssessmentModuleQuestion[]
  moduleAttempts StudentModuleAttempt[]

  @@index([assessmentId, order])
}

model AssessmentModuleQuestion {
  id            String           @id @default(cuid())
  moduleId      String
  module        AssessmentModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question         @relation(fields: [questionId], references: [id])
  order         Int              @default(0)
  marks         Decimal          @db.Decimal(6, 2)
  negativeMarks Decimal          @default(0) @db.Decimal(6, 2)

  questionAttempts StudentQuestionAttempt[]

  @@unique([moduleId, questionId])
  @@index([moduleId, order])
  @@index([questionId])
}

// ---------------------------------------------------------------------------
// Student attempts.
// ---------------------------------------------------------------------------

model StudentAssessment {
  id            String         @id @default(cuid())
  assessmentId  String
  assessment    Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber Int            @default(1)
  status        AttemptStatus  @default(NOT_STARTED)

  startedAt        DateTime?
  // Server-authoritative deadline = startedAt + assessment.durationMinutes at
  // start time. Checked (not trusted from the client) on every autosave and
  // on submit — this is the "server-authoritative timer" without needing a
  // background worker to force-expire it (see schema section comment).
  serverExpiresAt  DateTime?
  submittedAt      DateTime?
  submissionReason SubmissionReason?

  totalMarksObtained Decimal? @db.Decimal(7, 2)
  totalMaxMarks      Decimal? @db.Decimal(7, 2)
  accuracyPercent    Decimal? @db.Decimal(5, 2)
  timeSpentSeconds   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moduleAttempts   StudentModuleAttempt[]
  questionAttempts StudentQuestionAttempt[]
  result           AssessmentResult?
  events           AssessmentEvent[]

  @@unique([assessmentId, studentId, attemptNumber])
  @@index([assessmentId])
  @@index([studentId])
  @@index([status])
}

model StudentModuleAttempt {
  id                  String            @id @default(cuid())
  studentAssessmentId String
  studentAssessment   StudentAssessment @relation(fields: [studentAssessmentId], references: [id], onDelete: Cascade)
  moduleId            String
  module              AssessmentModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  startedAt           DateTime?
  completedAt         DateTime?
  timeSpentSeconds    Int               @default(0)

  @@unique([studentAssessmentId, moduleId])
  @@index([moduleId])
}

model StudentQuestionAttempt {
  id                  String                   @id @default(cuid())
  studentAssessmentId String
  studentAssessment   StudentAssessment        @relation(fields: [studentAssessmentId], references: [id], onDelete: Cascade)
  moduleQuestionId    String
  moduleQuestion      AssessmentModuleQuestion @relation(fields: [moduleQuestionId], references: [id], onDelete: Cascade)
  // Denormalized from moduleQuestion.questionId so analytics can join
  // straight to Question (chapter/topic/skill/cognitive) without a detour
  // through AssessmentModuleQuestion on every aggregation query.
  questionId          String
  question            Question                 @relation(fields: [questionId], references: [id])

  state            QuestionAttemptState @default(NOT_VISITED)
  visitCount       Int                  @default(0)
  timeSpentSeconds Int                  @default(0)
  firstAnsweredAt  DateTime?
  lastAnsweredAt   DateTime?
  changeCount      Int                  @default(0)

  isCorrect     Boolean?
  marksObtained Decimal? @db.Decimal(6, 2)

  answer     StudentAnswer?
  evaluation Evaluation?

  @@unique([studentAssessmentId, moduleQuestionId])
  @@index([studentAssessmentId])
  @@index([questionId])
}

model StudentAnswer {
  id                String                 @id @default(cuid())
  questionAttemptId String                 @unique
  questionAttempt   StudentQuestionAttempt @relation(fields: [questionAttemptId], references: [id], onDelete: Cascade)
  // Shape depends on question type: selected option id(s), typed text,
  // numeric value, match-the-following pairs, etc. — see
  // lib/validation/question.ts for the per-type response contract.
  response          Json
  autosavedAt       DateTime               @default(now())
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  attachments AnswerAttachment[]
}

// Image/handwritten answer upload — same shape as the existing Note model,
// stored in Vercel Blob.
model AnswerAttachment {
  id        String        @id @default(cuid())
  answerId  String
  answer    StudentAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileName  String
  fileSize  Int
  mimeType  String
  createdAt DateTime      @default(now())

  @@index([answerId])
}

// ---------------------------------------------------------------------------
// Evaluation. Evaluation *is* the teacher's row (status/finalMarks/feedback/
// evaluatedBy) — there is no separate TeacherEvaluation table; AIEvaluation
// hangs off it as an optional suggestion the teacher can accept, edit, or
// ignore, but never one that can finalize marks itself.
// ---------------------------------------------------------------------------

model Evaluation {
  id                String                 @id @default(cuid())
  questionAttemptId String                 @unique
  questionAttempt   StudentQuestionAttempt @relation(fields: [questionAttemptId], references: [id], onDelete: Cascade)
  status            EvaluationStatus       @default(PENDING)
  finalMarks        Decimal?               @db.Decimal(6, 2)
  evaluatedById     String?
  evaluatedBy       User?                  @relation(fields: [evaluatedById], references: [id])
  evaluatedAt       DateTime?
  feedback          String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  aiEvaluation AIEvaluation?

  @@index([status])
}

model AIEvaluation {
  id                String     @id @default(cuid())
  evaluationId      String     @unique
  evaluation        Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  suggestedMarks    Decimal?   @db.Decimal(6, 2)
  keyPointsFound    String[]   @default([])
  missingConcepts   String[]   @default([])
  incorrectConcepts String[]   @default([])
  suggestedFeedback String?
  // OCR/transcription of a handwritten/image answer, when applicable.
  ocrText           String?
  model             String
  rawResponse       Json?
  createdAt         DateTime   @default(now())
}

// ---------------------------------------------------------------------------
// Results + precomputed analytics. AssessmentResult.status/publishedAt is
// the single gate a student's result endpoint checks — never inferred from
// Assessment.status, so publishing can happen per-student as evaluation
// finishes rather than all-or-nothing.
// ---------------------------------------------------------------------------

model AssessmentResult {
  id                  String            @id @default(cuid())
  studentAssessmentId String            @unique
  studentAssessment   StudentAssessment @relation(fields: [studentAssessmentId], references: [id], onDelete: Cascade)
  status              ResultStatus      @default(EVALUATION_PENDING)

  totalMarksObtained Decimal @db.Decimal(7, 2)
  totalMaxMarks      Decimal @db.Decimal(7, 2)
  percentage         Decimal @db.Decimal(5, 2)
  accuracyPercent    Decimal @db.Decimal(5, 2)

  rank       Int?
  percentile Decimal? @db.Decimal(5, 2)

  overallFeedback String?

  publishedAt   DateTime?
  publishedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapterMetrics      ChapterMetric[]
  topicMetrics        TopicMetric[]
  skillMetrics        SkillMetric[]
  cognitiveMetrics    CognitiveMetric[]
  questionTypeMetrics QuestionTypeMetric[]
  aiInsight           AIInsight?
  feedbackEntries     Feedback[]
  recommendations     Recommendation[]

  @@index([studentAssessmentId])
  @@index([status])
}

model ChapterMetric {
  id              String           @id @default(cuid())
  resultId        String
  result          AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  chapterId       String
  chapter         Chapter          @relation(fields: [chapterId], references: [id])
  attempted       Int
  correct         Int
  incorrect       Int
  marksObtained   Decimal          @db.Decimal(6, 2)
  maxMarks        Decimal          @db.Decimal(6, 2)
  accuracyPercent Decimal          @db.Decimal(5, 2)

  @@unique([resultId, chapterId])
  @@index([chapterId])
}

model TopicMetric {
  id              String           @id @default(cuid())
  resultId        String
  result          AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  topicId         String
  topic           Topic            @relation(fields: [topicId], references: [id])
  attempted       Int
  correct         Int
  incorrect       Int
  marksObtained   Decimal          @db.Decimal(6, 2)
  maxMarks        Decimal          @db.Decimal(6, 2)
  accuracyPercent Decimal          @db.Decimal(5, 2)

  @@unique([resultId, topicId])
  @@index([topicId])
}

model SkillMetric {
  id              String           @id @default(cuid())
  resultId        String
  result          AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  skill           QuestionSkill
  attempted       Int
  correct         Int
  incorrect       Int
  marksObtained   Decimal          @db.Decimal(6, 2)
  maxMarks        Decimal          @db.Decimal(6, 2)
  accuracyPercent Decimal          @db.Decimal(5, 2)

  @@unique([resultId, skill])
}

model CognitiveMetric {
  id              String           @id @default(cuid())
  resultId        String
  result          AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  level           CognitiveLevel
  attempted       Int
  correct         Int
  incorrect       Int
  marksObtained   Decimal          @db.Decimal(6, 2)
  maxMarks        Decimal          @db.Decimal(6, 2)
  accuracyPercent Decimal          @db.Decimal(5, 2)

  @@unique([resultId, level])
}

model QuestionTypeMetric {
  id                 String           @id @default(cuid())
  resultId           String
  result             AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  type               QuestionType
  attempted          Int
  correct            Int
  incorrect          Int
  averageTimeSeconds Int
  accuracyPercent    Decimal          @db.Decimal(5, 2)

  @@unique([resultId, type])
}

// Class/test-level aggregate, recomputed whenever a result on this
// assessment is published — read directly by the teacher analytics page,
// never recomputed on view.
model AssessmentMetric {
  id                 String     @id @default(cuid())
  assessmentId       String     @unique
  assessment         Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  attemptsCount      Int        @default(0)
  completedCount     Int        @default(0)
  averageScore       Decimal?   @db.Decimal(5, 2)
  highestScore       Decimal?   @db.Decimal(5, 2)
  lowestScore        Decimal?   @db.Decimal(5, 2)
  medianScore        Decimal?   @db.Decimal(5, 2)
  averageAccuracy    Decimal?   @db.Decimal(5, 2)
  averageTimeSeconds Int?
  updatedAt          DateTime   @updatedAt
}

// Per-question quality signal (spec: "is this question itself bad?") —
// updated whenever a result touching this question is finalized.
model QuestionMetric {
  id                 String   @id @default(cuid())
  questionId         String   @unique
  question           Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  timesAttempted     Int      @default(0)
  timesCorrect       Int      @default(0)
  timesIncorrect     Int      @default(0)
  timesSkipped       Int      @default(0)
  averageTimeSeconds Int?
  // MCQ distractor analysis: { optionId: percentSelected }.
  optionDistribution Json?
  updatedAt          DateTime @updatedAt
}

// The §31 AI-generated learning summary for one result. System prompt (see
// lib/assessment/ai/insight.ts) explicitly forbids clinical/diagnostic
// language, same technique already used in lib/ai/nvidia.ts.
model AIInsight {
  id                      String           @id @default(cuid())
  resultId                String           @unique
  result                  AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  summary                 String
  strengths               String[]         @default([])
  weaknesses              String[]         @default([])
  conceptGaps             String[]         @default([])
  cognitiveGaps           String[]         @default([])
  skillGaps               String[]         @default([])
  timeManagementNote      String?
  recommendations         String[]         @default([])
  suggestedNextAssessment String?
  teacherActionNote       String?
  model                   String
  generatedAt             DateTime         @default(now())
}

model Feedback {
  id         String           @id @default(cuid())
  resultId   String
  result     AssessmentResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  scope      FeedbackScope
  moduleId   String?
  questionId String?
  chapterId  String?
  authorId   String
  author     User             @relation(fields: [authorId], references: [id])
  content    String
  createdAt  DateTime         @default(now())

  @@index([resultId])
}

model Recommendation {
  id             String               @id @default(cuid())
  studentId      String
  student        StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resultId       String?
  result         AssessmentResult?    @relation(fields: [resultId], references: [id], onDelete: SetNull)
  content        String
  source         RecommendationSource @default(AI)
  overriddenById String?
  overriddenBy   User?                @relation(fields: [overriddenById], references: [id])
  createdAt      DateTime             @default(now())

  @@index([studentId])
}

// Cross-assessment rolling profile, one row per student, updated
// incrementally on every result publish (not recomputed from scratch) —
// JSON-keyed by subject/chapter/skill since those sets are open-ended.
model StudentLearningProfile {
  id                    String         @id @default(cuid())
  studentId             String         @unique
  student               StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  overallMasteryPercent Decimal?       @db.Decimal(5, 2)
  subjectMastery        Json?
  chapterMastery        Json?
  skillMastery          Json?
  cognitiveProfile      Json?
  persistentWeakAreas   String[]       @default([])
  improvingAreas        String[]       @default([])
  assessmentsCompleted  Int            @default(0)
  lastAssessmentAt      DateTime?
  updatedAt             DateTime       @updatedAt
}

// Append-only raw event log — distinct from the generic AuditLog above
// (which stays for teacher/admin administrative actions). Powers the §53
// analytics pipeline and the §48 integrity/behaviour tracking.
model AssessmentEvent {
  id                  String              @id @default(cuid())
  assessmentId        String
  assessment          Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentAssessmentId String?
  studentAssessment   StudentAssessment?  @relation(fields: [studentAssessmentId], references: [id], onDelete: Cascade)
  actorId             String
  actor               User                @relation(fields: [actorId], references: [id])
  type                AssessmentEventType
  payload             Json?
  createdAt           DateTime            @default(now())

  @@index([assessmentId, createdAt])
  @@index([studentAssessmentId])
}

enum LeadStatus {
  NEW
  CONTACTED
  SCHEDULED
  CLOSED
}

// What actually happened on a follow-up touchpoint — logged once per call/
// email/etc. rather than overwriting a single notes field, so the history of
// attempts on a lead is never lost.
enum LeadActivityOutcome {
  CALL_NO_ANSWER
  CALL_CONNECTED
  EMAILED
  WHATSAPP_SENT
  SCHEDULED_CALL
  NOT_INTERESTED
  CONVERTED
  OTHER
}

// Public "Book Free Counselling" form (app/(marketing)/book-counselling) —
// unauthenticated submissions, not linked to a User since most submitters
// haven't signed up yet. Reviewed under the support.read/support.manage
// permissions (see lib/auth/permissions.ts), which existed unused before this.
model CounsellingRequest {
  id            String     @id @default(cuid())
  parentName    String
  studentName   String
  relation      String
  email         String
  phone         String
  classBand     String?
  focusArea     String?
  preferredTime String?
  message       String?
  status        LeadStatus @default(NEW)
  internalNotes String?
  contactedAt   DateTime?
  // Denormalized from the latest LeadActivity's nextFollowUpAt (see
  // app/api/counselling-requests/[id]/activities) so "who's overdue" can be
  // queried/sorted without joining the activity log every time.
  nextFollowUpAt DateTime?
  activities     CounsellingRequestActivity[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([nextFollowUpAt])
}

// Public "Contact Us" form (app/(marketing)/contact) — same access model as
// CounsellingRequest above.
model ContactMessage {
  id             String     @id @default(cuid())
  name           String
  email          String
  reason         String
  message        String
  status         LeadStatus @default(NEW)
  internalNotes  String?
  nextFollowUpAt DateTime?
  activities     ContactMessageActivity[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([nextFollowUpAt])
}

// One row per follow-up attempt on a CounsellingRequest — an append-only log,
// not an editable field, so "we called twice, no answer, then emailed" stays
// visible instead of being overwritten.
model CounsellingRequestActivity {
  id             String              @id @default(cuid())
  requestId      String
  request        CounsellingRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId       String
  author         User                @relation(fields: [authorId], references: [id])
  outcome        LeadActivityOutcome
  note           String?
  nextFollowUpAt DateTime?
  createdAt      DateTime            @default(now())

  @@index([requestId, createdAt])
}

// Same as CounsellingRequestActivity, for ContactMessage.
model ContactMessageActivity {
  id             String              @id @default(cuid())
  messageId      String
  message        ContactMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  authorId       String
  author         User                @relation(fields: [authorId], references: [id])
  outcome        LeadActivityOutcome
  note           String?
  nextFollowUpAt DateTime?
  createdAt      DateTime            @default(now())

  @@index([messageId, createdAt])
}
